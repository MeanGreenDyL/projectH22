---
/**
 * Tiered stage view header (spec §9): five thresholds, evenly spaced, each linking to its
 * section. Stages, not a time scale. HTML rather than SVG so labels stay legible at phone width.
 */
import { PREPAREDNESS_STAGES, STAGE_LABEL, type PreparednessStage } from '../../schemas';
interface Props { counts: Record<PreparednessStage, number> }
const { counts } = Astro.props;
---
<figure>
  <ol class="relative grid grid-cols-5 gap-1 before:absolute before:left-[10%] before:right-[10%] before:top-[11px] before:h-0.5 before:bg-rule" aria-label="Stages of an outage">
    {PREPAREDNESS_STAGES.map((s) => (
      <li class="relative text-center">
        <a href={`#stage-${s}`} class="group inline-flex min-h-6 flex-col items-center no-underline">
          <span class="block h-6 w-6 rounded-full border-2 border-accent bg-surface group-hover:bg-accent" aria-hidden="true"></span>
          <span class="mt-1 block text-xs font-semibold text-ink sm:text-sm">{STAGE_LABEL[s].replace('First ', '')}</span>
          <span class="block text-[11px] text-ink-muted">{counts[s] === 0 ? 'not available yet' : `${counts[s]} item${counts[s] === 1 ? '' : 's'}`}</span>
        </a>
      </li>
    ))}
  </ol>
  <figcaption class="mt-2 text-xs text-ink-muted">From the start of an outage. Evenly spaced stages, not a time scale.</figcaption>
</figure>
