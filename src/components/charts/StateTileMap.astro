---
/**
 * US tile-grid map: one equal-size tile per state, so small states are as visible as large ones.
 * Sequential single-hue scale; zero is an outlined empty tile, never a coloured one.
 */
interface Props { values: Record<string, number>; label: string; hue?: string }
const { values, label, hue = 'var(--h22-accent)' } = Astro.props;
// Standard 12×8 tile grid (column, row).
const GRID: Record<string, [number, number]> = {
  AK: [0, 0], ME: [11, 0],
  VT: [10, 1], NH: [11, 1],
  WA: [1, 2], ID: [2, 2], MT: [3, 2], ND: [4, 2], MN: [5, 2], IL: [6, 2], WI: [7, 2], MI: [8, 2], NY: [9, 2], RI: [10, 2], MA: [11, 2],
  OR: [1, 3], NV: [2, 3], WY: [3, 3], SD: [4, 3], IA: [5, 3], IN: [6, 3], OH: [7, 3], PA: [8, 3], NJ: [9, 3], CT: [10, 3],
  CA: [1, 4], UT: [2, 4], CO: [3, 4], NE: [4, 4], MO: [5, 4], KY: [6, 4], WV: [7, 4], VA: [8, 4], MD: [9, 4], DE: [10, 4],
  AZ: [2, 5], NM: [3, 5], KS: [4, 5], AR: [5, 5], TN: [6, 5], NC: [7, 5], SC: [8, 5], DC: [9, 5],
  OK: [4, 6], LA: [5, 6], MS: [6, 6], AL: [7, 6], GA: [8, 6],
  HI: [0, 7], TX: [4, 7], FL: [9, 7], PR: [11, 7],
};
const S = 40, G = 3;
const W = 12 * S, H = 8 * S;
const max = Math.max(1, ...Object.values(values));
---
<svg class="h22-chart w-full max-w-xl" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
  {Object.entries(GRID).map(([st, [c, r]]) => {
    const v = values[st] ?? 0;
    return (
      <g>
        <rect x={c * S + G / 2} y={r * S + G / 2} width={S - G} height={S - G} rx="4"
          fill={v ? hue : 'none'} fill-opacity={v ? 0.15 + 0.85 * (v / max) : 0} stroke={v ? 'none' : 'var(--h22-rule)'}
          tabindex="0" data-tip={`${v}|${st}`} />
        <text x={c * S + S / 2} y={r * S + S / 2 + 4} text-anchor="middle" style={`pointer-events:none;fill:${v / max > 0.55 ? 'var(--h22-accent-contrast)' : 'var(--h22-ink-secondary)'}`}>{st}</text>
      </g>
    );
  })}
</svg>
<p class="mt-1 flex items-center gap-2 text-xs text-ink-muted">
  <span>0</span>
  <span class="inline-block h-2 w-24 rounded-sm" style={`background:linear-gradient(90deg, color-mix(in srgb, ${hue} 15%, transparent), ${hue})`} aria-hidden="true"></span>
  <span class="num">{max}</span>
</p>
