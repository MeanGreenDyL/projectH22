---
/** Single-series line chart with a per-period hover band that snaps to the nearest point. */
import type { Series } from '../../schemas';

interface Props { series: Series; height?: number; label?: string }
const { series: s, height = 160, label } = Astro.props;
const W = 640, H = height, PAD_L = 52, PAD_R = 12, PAD_T = 10, PAD_B = 22;
const pts = s.points;
const vals = pts.map((p) => p[1]);
const lo = Math.min(0, ...vals), hiRaw = Math.max(...vals);
const step = (() => { const raw = (hiRaw - lo) / 4 || 1; const mag = 10 ** Math.floor(Math.log10(raw)); return [1, 2, 2.5, 5, 10].map((m) => m * mag).find((m) => m >= raw)!; })();
const hi = Math.ceil(hiRaw / step) * step || step;
const yTicks: number[] = [];
for (let v = Math.ceil(lo / step) * step; v <= hi + 1e-9; v += step) yTicks.push(Number(v.toPrecision(12)));
const x = (i: number) => PAD_L + (pts.length === 1 ? 0.5 : i / (pts.length - 1)) * (W - PAD_L - PAD_R);
const y = (v: number) => H - PAD_B - ((v - lo) / (hi - lo)) * (H - PAD_B - PAD_T);
const compact = (v: number) => new Intl.NumberFormat('en-US', { notation: Math.abs(hi) >= 10_000 ? 'compact' : 'standard', maximumFractionDigits: 2 }).format(v);
const d = pts.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p[1]).toFixed(1)}`).join('');
const area = `${d}L${x(pts.length - 1).toFixed(1)},${y(Math.max(lo, 0)).toFixed(1)}L${x(0).toFixed(1)},${y(Math.max(lo, 0)).toFixed(1)}Z`;
const xTickIdx = (() => { const n = Math.min(6, pts.length); return Array.from({ length: n }, (_, k) => Math.round((k * (pts.length - 1)) / Math.max(1, n - 1))); })();
const band = (W - PAD_L - PAD_R) / Math.max(1, pts.length - 1);
const last = pts[pts.length - 1]!;
const color = 'var(--h22-accent)';
---
<svg class="h22-chart w-full" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label ?? `${s.title}, ${pts.length} points`}>
  {yTicks.map((v) => (<g><line class="grid" x1={PAD_L} x2={W - PAD_R} y1={y(v)} y2={y(v)} /><text x={PAD_L - 6} y={y(v) + 4} text-anchor="end">{compact(v)}</text></g>))}
  <path d={area} fill={color} fill-opacity="0.08" />
  <path d={d} fill="none" stroke={color} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
  <circle cx={x(pts.length - 1)} cy={y(last[1])} r="4" fill={color} stroke="var(--h22-page)" stroke-width="2" />
  {xTickIdx.map((i) => <text x={x(i)} y={H - 6} text-anchor={i === 0 ? 'start' : i === pts.length - 1 ? 'end' : 'middle'}>{pts[i]![0]}</text>)}
  {pts.map((p, i) => <rect class="h22-hit" x={x(i) - band / 2} y={PAD_T} width={Math.max(band, 2)} height={H - PAD_T - PAD_B} data-tip={`${compact(p[1])} ${s.unit}|${p[0]}`} />)}
</svg>
