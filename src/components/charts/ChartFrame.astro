---
/**
 * Every chart sits in one of these (spec §8 rule 4): a one-line takeaway above, the "as of" date
 * and the source ids below, and a data table that is the accessible twin of the chart.
 */
interface Props {
  title: string;
  takeaway: string;
  /** null: the chart has no data yet, so there is no date to show. */
  asOf: string | undefined | null;
  sourceIds: string[];
  /** Extra caption text, e.g. the media-attention label. */
  note?: string | undefined;
  class?: string;
}
const { title, takeaway, asOf, sourceIds, note, class: cls = '' } = Astro.props;
const shown = sourceIds.slice(0, 6);
const more = sourceIds.length - shown.length;
---
<figure class={`h22-chart min-w-0 ${cls}`}>
  <p class="text-sm font-semibold text-ink">{title}</p>
  <p class="text-sm text-ink-secondary">{takeaway}</p>
  <div class="mt-3"><slot /></div>
  <figcaption class="mt-2 text-xs text-ink-muted">
    {note && <span class="block">{note}</span>}
    {asOf !== null && <span>As of <span class="num">{asOf ?? 'not available'}</span>.</span>}
    {sourceIds.length > 0 && (
      <span> Sources: {shown.map((id, i) => (<>{i > 0 && ', '}<a class="text-accent" href={`/sources/#${id}`}>{id}</a></>))}{more > 0 && <> and {more} more (<a class="text-accent" href="/sources/">all sources</a>)</>}.</span>
    )}
  </figcaption>
  {Astro.slots.has('table') && (
    <details class="mt-1 text-xs">
      <summary class="cursor-pointer text-ink-muted">Show data table</summary>
      <div class="mt-2 max-h-80 overflow-auto"><slot name="table" /></div>
    </details>
  )}
</figure>
