---
import Base from '../../layouts/Base.astro';
import ChartFrame from '../../components/charts/ChartFrame.astro';
import CorrelationMatrix from '../../components/charts/CorrelationMatrix.astro';
import CorrelationBrowser from '../../components/interp/CorrelationBrowser';
import StrengthLegend from '../../components/interp/StrengthLegend';
import { siteData } from '../../lib/site-data';
import { correlationMatrix } from '../../lib/chart-data';
import { browserPayload } from '../../lib/correlation-payload';
import { DOMAIN_LABEL } from '../../lib/labels';

const data = await siteData();
const matrix = correlationMatrix(data.correlations, data.eventsById);
const { items, sources } = browserPayload(data);
---
<Base title="Correlations" description="Proposed readings linking verified events to scripture, each labelled with its strength, tradition and the case against it.">
  <h1 class="font-heading text-3xl">Correlations</h1>
  <p class="mt-1 max-w-[var(--measure-prose)] text-ink-secondary">Proposed readings, not facts. Each one states its strength, its reading tradition, and the strongest case against it.</p>

  <section class="mt-6 rounded-md bg-interp-surface p-4">
    <ChartFrame title="Correlations by event domain and book" takeaway="Darker cells have more published correlations. Border style shows the most common strength." asOf={matrix.books.length ? undefined : null} sourceIds={[]}>
      <CorrelationMatrix books={matrix.books} cells={matrix.cells} />
    </ChartFrame>
  </section>

  <section class="mt-8">
    <h2 class="font-heading text-xl">How strong is each reading?</h2>
    <div class="mt-3"><StrengthLegend /></div>
  </section>

  <section class="mt-8">
    <h2 class="font-heading text-xl">Browse</h2>
    {items.length === 0 ? (
      <p class="mt-3 rounded-md border border-dashed border-interp-rule p-4 text-sm text-ink-secondary">
        No correlations are published yet. Drafts exist only for human review; a correlation appears here after a named reviewer approves it.
      </p>
    ) : (
      <div class="mt-3"><CorrelationBrowser client:visible items={items} sources={sources} domainLabels={DOMAIN_LABEL} /></div>
    )}
  </section>
</Base>
