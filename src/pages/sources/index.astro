---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { barPath } from '../../components/charts/colpath';
import { EVIDENTIARY_TIERS, TIER_DEFINITIONS, TIER_LABELS, type Source } from '../../schemas';

const sources = (await getCollection('sources')).map((s) => s.data as Source);
const events = await getCollection('events');
const series = await getCollection('series');
const citedBy = new Map<string, number>();
for (const e of events) for (const id of new Set(e.data.sources)) citedBy.set(id, (citedBy.get(id) ?? 0) + 1);
for (const s of series) citedBy.set(s.data.sourceId, (citedBy.get(s.data.sourceId) ?? 0) + 1);

const tierOf = (s: Source) => (s.kind === 'evidentiary' ? s.tier : undefined);
const tierCounts = EVIDENTIARY_TIERS.map((t) => ({ t, n: sources.filter((s) => tierOf(s) === t).length }));
const interpretiveCount = sources.filter((s) => s.kind === 'interpretive').length;
const tierBars = [...tierCounts.map(({ t, n }) => ({ label: TIER_LABELS[t], n })), { label: 'Interpretive', n: interpretiveCount }];
const maxTier = Math.max(1, ...tierBars.map((b) => b.n));

const publishers = [...new Set(sources.map((s) => s.publisher))]
  .map((p) => ({ p, items: sources.filter((s) => s.publisher === p).sort((a, b) => (b.publishedAt ?? b.accessedAt).localeCompare(a.publishedAt ?? a.accessedAt)) }))
  .sort((a, b) => b.items.length - a.items.length || a.p.localeCompare(b.p));
const day = (iso: string) => iso.slice(0, 10);
---
<Base title="Sources" description="Every source cited on the site, its evidence tier, and its archived copy.">
  <h1 class="font-heading text-3xl">Sources</h1>
  <p class="mt-2 max-w-[var(--measure-prose)] text-ink-secondary">
    Every citation on this site points to an entry here. Each entry carries an evidence tier and,
    where one exists, an archived copy so the citation survives if the original page changes.
  </p>

  <figure class="h22-chart mt-6 max-w-2xl" aria-label="Sources by evidence tier">
    <svg class="w-full" viewBox={`0 0 600 ${tierBars.length * 26 + 4}`} role="img" aria-label={tierBars.map((b) => `${b.label}: ${b.n}`).join(', ')}>
      {tierBars.map((b, i) => (
        <g>
          <text x="188" y={i * 26 + 17} text-anchor="end" style="fill:var(--h22-ink-secondary);font-size:12px">{b.label}</text>
          {b.n > 0 && <path d={barPath(196, i * 26 + 6, (b.n / maxTier) * 360, 14)} fill="var(--h22-accent)" />}
          <text x={200 + (b.n / maxTier) * 360} y={i * 26 + 17}>{b.n}</text>
        </g>
      ))}
    </svg>
  </figure>

  <h2 class="mt-8 font-heading text-2xl">Evidence tiers</h2>
  <dl class="mt-3 grid gap-3 sm:grid-cols-2">
    {tierCounts.map(({ t, n }) => (
      <div class="border-t border-rule pt-2">
        <dt class="flex items-baseline justify-between gap-3"><span class="font-semibold">{TIER_LABELS[t]}</span><span class="num text-sm text-ink-muted">{n} sources</span></dt>
        <dd class="mt-1 text-sm text-ink-secondary">{TIER_DEFINITIONS[t]}</dd>
      </div>
    ))}
    <div class="border-t border-rule pt-2">
      <dt class="flex items-baseline justify-between gap-3"><span class="font-semibold">Interpretive</span><span class="num text-sm text-ink-muted">{interpretiveCount} sources</span></dt>
      <dd class="mt-1 text-sm text-ink-secondary">Commentaries, theology, reference works and lexicons. Used only for interpretation, never as evidence for a fact.</dd>
    </div>
  </dl>

  <h2 class="mt-10 font-heading text-2xl">By publisher</h2>
  <div class="mt-3 divide-y divide-rule border-y border-rule">
    {publishers.map(({ p, items }) => (
      <details class="py-2">
        <summary class="cursor-pointer"><span class="font-semibold">{p}</span> <span class="num text-sm text-ink-muted">{items.length}</span></summary>
        <ul class="mt-2 space-y-2 text-sm">
          {items.map((s) => (
            <li id={s.id}>
              <a class="text-accent" href={s.url} rel="noopener">{s.title}</a>
              <div class="text-xs text-ink-muted">
                {s.kind === 'evidentiary' ? TIER_LABELS[s.tier] : `Interpretive · ${s.interpretiveClass}`}
                {' · '}accessed <span class="num">{day(s.accessedAt)}</span>
                {' · '}{s.archiveUrl ? <a class="text-accent" href={s.archiveUrl} rel="noopener">archived copy</a> : <span>no archived copy</span>}
                {' · '}cited by <span class="num">{citedBy.get(s.id) ?? 0}</span>
              </div>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </div>
</Base>
